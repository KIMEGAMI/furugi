[Unit]
Description=FURUGI Laravel queue worker
After=network.target mysql.service mariadb.service
Wants=mysql.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/furugi
ExecStart=/usr/bin/php artisan queue:work --sleep=3 --tries=3 --timeout=90
ExecReload=/usr/bin/php artisan queue:restart
Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
