APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_FORCE_HTTPS=false

SEO_SITE_NAME=FURUGI
SEO_TITLE="FURUGI | 古着販売の在庫管理・売上管理システム"
SEO_DESCRIPTION="FURUGIは、古着販売の商品登録、画像管理、SOLD管理、売上分析、CSV取込、ジャンル別分析をまとめて行える在庫管理システムです。"
SEO_KEYWORDS="古着 管理,古着 在庫管理,フリマ 在庫管理,売上管理,メルカリ 管理,ヤフオク 管理,古着販売 ツール"
SEO_IMAGE=/images/logo.png

PWA_NAME=FURUGI
PWA_SHORT_NAME=FURUGI
PWA_DESCRIPTION="古着販売向け在庫管理システム"
PWA_THEME_COLOR="#0f172a"
PWA_BACKGROUND_COLOR="#f8fafc"
PWA_DISPLAY=standalone
PWA_START_URL=/
PWA_SCOPE=/
PWA_CACHE_NAME=furugi-pwa-v1

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database
FURUGI_MAINTENANCE_ENABLED=false
FURUGI_MAINTENANCE_TITLE="メンテナンス中です"
FURUGI_MAINTENANCE_MESSAGE="現在、サービス改善のため一時的にご利用いただけません。しばらく時間をおいてから再度アクセスしてください。"
FURUGI_MAINTENANCE_RETRY_AFTER=1800
FURUGI_MAINTENANCE_ALLOW_IPS=

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

ADMIN_EMAIL=admin@shinji.work
ADMIN_PASSWORD=

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
CONTACT_TO_ADDRESS=
CONTACT_TO_NAME="${APP_NAME}"
CONTACT_SUBJECT_PREFIX="FURUGIお問い合わせ"
CONTACT_MAX_NAME_LENGTH=80
CONTACT_MAX_SUBJECT_LENGTH=120
CONTACT_MAX_MESSAGE_LENGTH=3000

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_PREMIUM_PRICE_ID=
STRIPE_PREMIUM_AMOUNT=480
STRIPE_PREMIUM_CURRENCY=jpy

VITE_APP_NAME="${APP_NAME}"
